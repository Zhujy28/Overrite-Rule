name: Apple Intelligence
desc: 允许Apple Intelligence中的ChatGPT服务


proxy-groups:
  - name: Apple-Intelligence
    icon: https://developer.apple.com/assets/elements/icons/apple-intelligence/apple-intelligence-128x128.png
    type: url-test
    include-all: true
    interval: 120
    tolerance: 50
    lazy: true
    filter: "(?i)(新加坡|坡|狮城|🇸🇬|sg|singapore)"



rules:
  - DOMAIN,guzzoni.apple.com,Apple-Intelligence
  - DOMAIN,smoot.apple.com,Apple-Intelligence
  - DOMAIN,gspe1-ssl.ls.apple.com,Apple-Intelligence
  - DOMAIN,gateway.icloud.com,Apple-Intelligence

  # 2. Apple 隐私中继与 Cloudflare/Fastly/Akamai 边缘节点（防止检测真实 IP）
  - DOMAIN,apple-relay.apple.com,Apple-Intelligence
  - DOMAIN,apple-relay.cloudflare.com,Apple-Intelligence
  - DOMAIN,apple-relay.fastly-edge.com,Apple-Intelligence
  - DOMAIN,apple-relay.akamaized.net,Apple-Intelligence
  - DOMAIN,apple-relay.mask.apple-dns.net,Apple-Intelligence
  - DOMAIN,cp4.cloudflare.com,Apple-Intelligence

  # 3. 苹果静态资源/App Store 关联组件
  - DOMAIN-SUFFIX,apps.mzstatic.com,Apple-Intelligence

