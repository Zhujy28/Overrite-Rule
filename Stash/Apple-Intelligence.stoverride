name: Apple Intelligence
desc: 允许Apple Intelligence中的ChatGPT服务



proxy-groups:
  - name: Apple-Intelligence
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure/IconSet/Color/Global.png
    type: select
    proxies:
      - 手动选择

rules:
  - DOMAIN,guzzoni.smoot.apple.com,Apple-Intelligence
  - DOMAIN,seed.siri.apple.com,Apple-Intelligence
  - DOMAIN,xp.apple.com,Apple-Intelligence
  - DOMAIN-SUFFIX,apps.mzstatic.com,Apple-Intelligence
  - DOMAIN-SUFFIX,mask.icloud.com,Apple-Intelligence
  - DOMAIN-SUFFIX,icloud-content.com,Apple-Intelligence
  - DOMAIN-SUFFIX,mask-h2.icloud.com,Apple-Intelligence
  - DOMAIN-SUFFIX,ls.apple.com,Apple-Intelligence
  - DOMAIN-SUFFIX,apple-relay.mask.apple-dns.net,Apple-Intelligence
  - DOMAIN-SUFFIX,mask-api.fe.apple-dns.net,Apple-Intelligence
  - DOMAIN,mask.apple-dns.net,Apple-Intelligence
  - DOMAIN,mask-t.apple-dns.net,Apple-Intelligence
  - DOMAIN,mask-api.icloud.com,Apple-Intelligence
  - DOMAIN,mask-api.fe.apple-dns.net,Apple-Intelligence
  - DOMAIN,gsp76-cn-ssl.ls.apple.com,Apple-Intelligence
  - DOMAIN,weatherkit.apple.com,Apple-Intelligence
  - DOMAIN,gspe35-ssl.ls.apple.com,Apple-Intelligence
  - DOMAIN,gspe21-ssl.ls.apple.com,Apple-Intelligence
  - DOMAIN,gateway.icloud.com,Apple-Intelligence
  - DOMAIN,gspe1-ssl.ls.apple.com,Apple-Intelligence
  - DOMAIN,gspel-ssl.ls.apple.com,Apple-Intelligence
  - DOMAIN,smoot.apple.com,Apple-Intelligence
  - DOMAIN,guzzoni.apple.com,Apple-Intelligence
  - DOMAIN,cp4.cloudflare.com,Apple-Intelligence
  - DOMAIN,apple-relay.mask.apple-dns.net,Apple-Intelligence
  - DOMAIN,apple-relay.akamaized.net,Apple-Intelligence
  - DOMAIN,apple-relay.fastly-edge.com,Apple-Intelligence
  - DOMAIN,apple-relay.cloudflare.com,Apple-Intelligence
  - DOMAIN,apple-relay.apple.com,Apple-Intelligence
  - DOMAIN-KEYWORD,siri,Apple-Intelligence


